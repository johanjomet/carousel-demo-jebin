<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
<style>
  :root{
    --ink:#070B17;
    --ink-2:#0C1428;
    --brand:#FF6B2C;
    --brand-2:#FF9D3C;
    --navy:#17275B;
    --muted:#6A7488;
    --line:rgba(12,20,40,.09);
  }
  html,body{ -webkit-font-smoothing:antialiased; }
  body{ font-family:'Plus Jakarta Sans',system-ui,sans-serif; color:#0C1428; background:#fff; overflow-x:hidden; }
  h1,h2,h3,h4,.font-display{ font-family:'Sora',system-ui,sans-serif; letter-spacing:-.02em; }
  ::selection{ background:var(--brand); color:#fff; }

  /* ---------- decorative ---------- */
  .grid-bg{
    background-image:linear-gradient(rgba(255,255,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.045) 1px,transparent 1px);
    background-size:64px 64px;
  }
  .grid-bg-light{
    background-image:linear-gradient(rgba(12,20,40,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(12,20,40,.045) 1px,transparent 1px);
    background-size:56px 56px;
  }
  .glow{ position:absolute; border-radius:9999px; filter:blur(90px); pointer-events:none; }
  .text-gradient{ background:linear-gradient(94deg,#FF6B2C,#FFB457 60%,#FF6B2C); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .shadow-soft{ box-shadow:0 2px 6px rgba(12,20,40,.04),0 18px 40px -22px rgba(12,20,40,.25); }
  .shadow-lift{ box-shadow:0 30px 70px -32px rgba(12,20,40,.45); }

  /* corner fold accent (inspired by the reference cards) */
  .fold:after{
    content:""; position:absolute; right:0; bottom:0; width:0; height:0;
    border-style:solid; border-width:0 0 46px 46px; border-color:transparent transparent var(--brand) transparent;
    transition:.45s cubic-bezier(.22,.8,.25,1); opacity:.95;
  }
  .fold:hover:after{ border-width:0 0 110px 110px; }

  /* ---------- carousel core ---------- */
  .rail-viewport{ overflow:hidden; cursor:grab; }
  .rail-viewport.is-dragging{ cursor:grabbing; }
  .rail-track{ display:flex; will-change:transform; touch-action:pan-y; }
  .rail-track > *{ flex:0 0 auto; min-width:0; }
  .rail-btn{
    display:grid; place-items:center; width:54px; height:54px; border-radius:9999px;
    background:#fff; color:#0C1428; border:1px solid var(--line);
    transition:.35s cubic-bezier(.22,.8,.25,1); box-shadow:0 14px 30px -18px rgba(12,20,40,.5);
  }
  .rail-btn:hover{ background:var(--brand); color:#fff; border-color:var(--brand); transform:translateY(-3px); box-shadow:0 18px 34px -14px rgba(255,107,44,.6); }
  .rail-btn.ghost{ background:rgba(255,255,255,.07); border-color:rgba(255,255,255,.18); color:#fff; backdrop-filter:blur(8px); }
  .rail-btn.ghost:hover{ background:var(--brand); border-color:var(--brand); }
  .dot{ width:9px; height:9px; border-radius:9999px; background:rgba(12,20,40,.18); transition:.4s cubic-bezier(.22,.8,.25,1); }
  .dot.is-active{ width:34px; background:var(--brand); }
  .dot.light{ background:rgba(255,255,255,.26); }
  .dot.light.is-active{ background:var(--brand); }
  .progress-track{ position:relative; height:3px; width:100%; background:rgba(12,20,40,.1); border-radius:9999px; overflow:hidden; }
  .progress-track.light{ background:rgba(255,255,255,.14); }
  .progress-bar{ position:absolute; inset:0 auto 0 0; width:0%; background:linear-gradient(90deg,var(--brand),var(--brand-2)); border-radius:9999px; }

  /* coverflow */
  .cf-stage{ position:relative; perspective:1800px; }
  .cf-item{ position:absolute; top:0; left:50%; transition:transform .85s cubic-bezier(.19,1,.22,1),opacity .6s ease,filter .6s ease; transform-style:preserve-3d; }

  /* reveal */
  [data-reveal]{ opacity:0; transform:translateY(26px); }
  .revealed[data-reveal]{ opacity:1; transform:none; transition:opacity .9s cubic-bezier(.22,.8,.25,1),transform .9s cubic-bezier(.22,.8,.25,1); }

  /* marquee */
  @keyframes slide-x{ from{ transform:translateX(0);} to{ transform:translateX(-50%);} }
  .marquee{ display:flex; width:max-content; animation:slide-x 36s linear infinite; }
  .marquee:hover{ animation-play-state:paused; }
  @keyframes float-y{ 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-14px);} }
  .floaty{ animation:float-y 7s ease-in-out infinite; }
  @keyframes spin-slow{ to{ transform:rotate(360deg);} }
  .spin-slow{ animation:spin-slow 22s linear infinite; }

  .link-underline{ background-image:linear-gradient(var(--brand),var(--brand)); background-size:0% 1.5px; background-repeat:no-repeat; background-position:0 100%; transition:background-size .4s ease; }
  .link-underline:hover{ background-size:100% 1.5px; }
  .nav-pill{ position:relative; }
  .nav-pill:before{ content:""; position:absolute; inset:-8px -14px; border-radius:9999px; background:rgba(255,255,255,.1); opacity:0; transform:scale(.85); transition:.35s cubic-bezier(.22,.8,.25,1); }
  .nav-pill:hover:before{ opacity:1; transform:scale(1); }
  .btn-sheen{ position:relative; overflow:hidden; }
  .btn-sheen:after{ content:""; position:absolute; top:0; left:-130%; width:60%; height:100%; background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent); transform:skewX(-20deg); transition:left .7s ease; }
  .btn-sheen:hover:after{ left:130%; }
  .no-scrollbar::-webkit-scrollbar{ display:none; }
  /* header colour inversion when solid */
  .hdr-solid{ background:#fff!important; border-color:rgba(12,20,40,.08)!important; box-shadow:0 2px 6px rgba(12,20,40,.04),0 18px 40px -26px rgba(12,20,40,.35); }
  .hdr-solid .nav-ink{ color:#0C1428!important; }
  .hdr-solid button.nav-ink{ border-color:rgba(12,20,40,.12)!important; }
  .hdr-solid .nav-pill:before{ background:rgba(12,20,40,.06); }
  /* active thumbnail */
  .thumb-active{ background:#0C1428!important; color:#fff!important; transform:translateY(-4px); box-shadow:0 18px 40px -22px rgba(12,20,40,.6); border-color:#0C1428!important; }
  .thumb-active span:first-child{ background:#FF6B2C!important; color:#fff!important; }
  @media (prefers-reduced-motion:reduce){ *{ animation:none!important; transition-duration:.01ms!important; } }
</style>
</head>
