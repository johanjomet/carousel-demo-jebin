/* =========================================================
   CAROUSEL ENGINE (hand-written, no dependencies)
   ========================================================= */
class Rail {
  constructor(root){
    this.root = root;
    this.viewport = root.querySelector('[data-viewport]');
    this.track = root.querySelector('[data-track]');
    this.opts = Object.assign({ perView:{0:1}, gap:24, loop:true, autoplay:0, speed:720 },
                              JSON.parse(root.dataset.options || '{}'));
    this.real = Array.from(this.track.children);
    this.count = this.real.length;
    if(!this.count) return;

    this.maxPV = Math.ceil(Math.max(...Object.values(this.opts.perView)));
    this.loop = this.opts.loop && this.count > this.maxPV;
    this.cloneCount = this.loop ? this.maxPV : 0;

    if(this.loop){
      const head = this.real.slice(0, this.cloneCount).map(n=>n.cloneNode(true));
      const tail = this.real.slice(-this.cloneCount).map(n=>n.cloneNode(true));
      tail.forEach(n=>{ n.setAttribute('aria-hidden','true'); this.track.insertBefore(n, this.track.firstChild); });
      head.forEach(n=>{ n.setAttribute('aria-hidden','true'); this.track.appendChild(n); });
    }
    this.slides = Array.from(this.track.children);
    this.pos = this.cloneCount;

    this.buildDots();
    this.bind();
    this.measure();
    this.apply(false);
    this.startAuto();
  }

  pv(){
    const w = window.innerWidth;
    let best = 1;
    Object.keys(this.opts.perView).map(Number).sort((a,b)=>a-b)
      .forEach(bp=>{ if(w >= bp) best = this.opts.perView[bp]; });
    return best;
  }

  measure(){
    const pv = this.pv();
    const gap = this.opts.gap;
    const vw = this.viewport.clientWidth;
    this.slideW = (vw - gap * (Math.ceil(pv) - 1)) / pv;
    this.step = this.slideW + gap;
    this.track.style.gap = gap + 'px';
    this.slides.forEach(s=>{ s.style.width = this.slideW + 'px'; });
    this.maxPos = this.loop ? Infinity : Math.max(0, this.count - Math.floor(pv));
    this.apply(false);
  }

  apply(animate = true){
    this.track.style.transition = animate ? `transform ${this.opts.speed}ms cubic-bezier(.19,1,.22,1)` : 'none';
    this.track.style.transform = `translate3d(${-this.pos * this.step}px,0,0)`;
    if(!animate) this.track.getBoundingClientRect();
    this.syncDots();
  }

  realIndex(){
    return ((this.pos - this.cloneCount) % this.count + this.count) % this.count;
  }

  go(p, animate = true){
    if(!this.loop) p = Math.max(0, Math.min(p, this.maxPos));
    this.pos = p;
    this.apply(animate);
    this.restartAuto();
  }
  next(){ this.go(this.pos + 1); }
  prev(){ this.go(this.pos - 1); }
  goReal(i){ this.go(this.cloneCount + i); }

  normalize(){
    if(!this.loop) return;
    let p = this.pos;
    if(p >= this.cloneCount + this.count) p -= this.count;
    else if(p < this.cloneCount) p += this.count;
    if(p !== this.pos){ this.pos = p; this.apply(false); }
  }

  buildDots(){
    this.dotsWrap = this.root.querySelector('[data-dots]');
    if(!this.dotsWrap) return;
    const light = this.root.closest('.bg-\\[\\#070B17\\]') || this.root.dataset.dotsLight;
    this.dotsWrap.innerHTML = this.real.map((_,i)=>
      `<button class="dot ${light?'light':''}" data-dot="${i}" aria-label="Go to slide ${i+1}"></button>`).join('');
    this.dotsWrap.addEventListener('click', e=>{
      const b = e.target.closest('[data-dot]');
      if(b) this.goReal(+b.dataset.dot);
    });
  }
  syncDots(){
    if(!this.dotsWrap) return;
    const i = this.realIndex();
    this.dotsWrap.querySelectorAll('[data-dot]').forEach((d,k)=>d.classList.toggle('is-active', k === i));
  }

  /* ---- autoplay with progress bar ---- */
  startAuto(){
    this.progress = this.root.querySelector('[data-progress]');
    if(!this.opts.autoplay) return;
    this.autoStart = performance.now();
    this.paused = false;
    const tick = now =>{
      this.raf = requestAnimationFrame(tick);
      if(this.paused || this.dragging){ this.autoStart = now - this.elapsed; return; }
      this.elapsed = now - this.autoStart;
      const pct = Math.min(1, this.elapsed / this.opts.autoplay);
      if(this.progress) this.progress.style.width = (pct * 100) + '%';
      if(pct >= 1){ this.autoStart = now; this.elapsed = 0; this.go(this.pos + 1); }
    };
    this.elapsed = 0;
    this.raf = requestAnimationFrame(tick);
  }
  restartAuto(){ this.autoStart = performance.now(); this.elapsed = 0; if(this.progress) this.progress.style.width = '0%'; }

  bind(){
    this.track.addEventListener('transitionend', ()=>this.normalize());

    const navScopes = [this.root, document.querySelector(`[data-rail-nav="${this.root.id}"]`),
                       ...document.querySelectorAll(`[data-rail-nav-for="${this.root.id}"]`)].filter(Boolean);
    navScopes.forEach(scope=>{
      scope.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click', ()=>this.prev()));
      scope.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click', ()=>this.next()));
      if(scope.matches('[data-prev]')) scope.addEventListener('click', ()=>this.prev());
      if(scope.matches('[data-next]')) scope.addEventListener('click', ()=>this.next());
    });

    this.root.addEventListener('mouseenter', ()=>this.paused = true);
    this.root.addEventListener('mouseleave', ()=>this.paused = false);

    // pointer drag
    let startX = 0, startPos = 0, dx = 0, active = false, startY = 0, locked = null;
    const down = e =>{
      active = true; this.dragging = true; locked = null; dx = 0;
      startX = e.clientX ?? e.touches[0].clientX;
      startY = e.clientY ?? e.touches[0].clientY;
      startPos = this.pos;
      this.viewport.classList.add('is-dragging');
      this.track.style.transition = 'none';
    };
    const move = e =>{
      if(!active) return;
      const x = e.clientX ?? e.touches[0].clientX;
      const y = e.clientY ?? e.touches[0].clientY;
      if(locked === null){
        const ax = Math.abs(x - startX), ay = Math.abs(y - startY);
        if(ax < 5 && ay < 5) return;              // wait for a meaningful gesture
        locked = ax >= ay ? 'x' : 'y';
        if(locked === 'y'){ active = false; this.dragging = false; this.viewport.classList.remove('is-dragging'); return; }
      }
      dx = x - startX;
      if(e.cancelable) e.preventDefault();
      this.track.style.transform = `translate3d(${-startPos * this.step + dx}px,0,0)`;
    };
    const up = ()=>{
      if(!active) return;
      active = false; this.dragging = false;
      this.viewport.classList.remove('is-dragging');
      let moved = Math.round(-dx / this.step);
      if(moved === 0 && Math.abs(dx) > this.step * 0.14) moved = dx < 0 ? 1 : -1;
      this.go(startPos + moved);
      if(Math.abs(dx) > 6){
        this.viewport.querySelectorAll('a').forEach(a=>{
          const block = ev=>{ ev.preventDefault(); a.removeEventListener('click', block, true); };
          a.addEventListener('click', block, true);
          setTimeout(()=>a.removeEventListener('click', block, true), 120);
        });
      }
    };
    this.viewport.addEventListener('pointerdown', down);
    window.addEventListener('pointermove', move, { passive:false });
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    this.viewport.addEventListener('dragstart', e=>e.preventDefault());

    // keyboard
    this.root.tabIndex = 0;
    this.root.addEventListener('keydown', e=>{
      if(e.key === 'ArrowLeft') this.prev();
      if(e.key === 'ArrowRight') this.next();
    });

    let t; window.addEventListener('resize', ()=>{ clearTimeout(t); t = setTimeout(()=>this.measure(), 140); });
  }
}

