/* =========================================================
   3D COVERFLOW
   ========================================================= */
class Coverflow {
  constructor(root){
    this.root = root;
    this.stage = root.querySelector('[data-cf-stage]');
    this.items = Array.from(root.querySelectorAll('[data-cf-item]'));
    this.n = this.items.length;
    this.i = 0;
    this.dots = root.querySelector('[data-cf-dots]');
    this.dots.innerHTML = this.items.map((_,k)=>`<button class="dot light" data-cfdot="${k}" aria-label="Slide ${k+1}"></button>`).join('');
    root.querySelector('[data-cf-total]').textContent = String(this.n).padStart(2,'0');
    this.render();
    this.bind();
    this.auto();
  }
  render(){
    const w = this.items[0].offsetWidth || 320;
    const shift = Math.min(w * 0.62, window.innerWidth < 640 ? 120 : 210);
    this.items.forEach((el,k)=>{
      let d = k - this.i;
      if(d > this.n/2) d -= this.n;
      if(d < -this.n/2) d += this.n;
      const abs = Math.abs(d);
      const visible = abs <= 2;
      el.style.transform = `translateX(calc(-50% + ${d*shift}px)) translateZ(${-abs*170}px) rotateY(${d*-22}deg) scale(${1 - abs*0.07})`;
      el.style.opacity = visible ? (abs === 0 ? 1 : abs === 1 ? .62 : .25) : 0;
      el.style.filter = abs === 0 ? 'none' : `blur(${abs*1.2}px)`;
      el.style.zIndex = 50 - abs;
      el.style.pointerEvents = abs === 0 ? 'auto' : 'none';
    });
    this.root.querySelector('[data-cf-current]').textContent = String(this.i+1).padStart(2,'0');
    this.dots.querySelectorAll('[data-cfdot]').forEach((d,k)=>d.classList.toggle('is-active', k === this.i));
  }
  go(i){ this.i = (i % this.n + this.n) % this.n; this.render(); this.t0 = performance.now(); }
  next(){ this.go(this.i+1); } prev(){ this.go(this.i-1); }
  auto(){
    this.t0 = performance.now();
    const loop = now =>{
      requestAnimationFrame(loop);
      if(this.hover || document.hidden){ this.t0 = now; return; }
      if(now - this.t0 > 4200){ this.t0 = now; this.next(); }
    };
    requestAnimationFrame(loop);
  }
  bind(){
    this.root.querySelector('[data-cf-next]').addEventListener('click', ()=>this.next());
    this.root.querySelector('[data-cf-prev]').addEventListener('click', ()=>this.prev());
    this.dots.addEventListener('click', e=>{ const b = e.target.closest('[data-cfdot]'); if(b) this.go(+b.dataset.cfdot); });
    this.root.addEventListener('mouseenter', ()=>this.hover = true);
    this.root.addEventListener('mouseleave', ()=>this.hover = false);
    let sx = null, sy = null;
    this.stage.addEventListener('pointerdown', e=>{ sx = e.clientX; sy = e.clientY; });
    window.addEventListener('pointerup', e=>{
      if(sx === null) return;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      if(Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) dx < 0 ? this.next() : this.prev();
      sx = null;
    });
    window.addEventListener('resize', ()=>this.render());
  }
}
new Coverflow(document.getElementById('coverflow'));

/* =========================================================
   UI: header, reveal, counters, drawer, misc
   ========================================================= */
const header = document.getElementById('headerInner');
const navInk = document.querySelectorAll('.nav-ink');
const onScroll = ()=>{
  const y = window.scrollY;
  const solid = y > 70;
  header.classList.toggle('hdr-solid', solid);
  const h = document.documentElement;
  document.getElementById('scrollProgress').style.width = (y / (h.scrollHeight - h.clientHeight) * 100) + '%';
  const top = document.getElementById('toTop');
  top.classList.toggle('opacity-0', y < 600);
  top.classList.toggle('translate-y-4', y < 600);
  top.classList.toggle('pointer-events-none', y < 600);
};
window.addEventListener('scroll', onScroll, { passive:true }); onScroll();

const io = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){ e.target.classList.add('revealed'); io.unobserve(e.target); }
  });
}, { threshold:.12, rootMargin:'0px 0px -60px' });
document.querySelectorAll('[data-reveal]').forEach((el,i)=>{ el.style.transitionDelay = (i%3)*90 + 'ms'; io.observe(el); });

const cio = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(!e.isIntersecting) return;
    const el = e.target, to = +el.dataset.to, dur = 1600, t0 = performance.now();
    const step = now =>{
      const p = Math.min(1, (now - t0)/dur);
      el.textContent = Math.round(to * (1 - Math.pow(1-p, 3))).toLocaleString();
      if(p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step); cio.unobserve(el);
  });
}, { threshold:.5 });
document.querySelectorAll('.counter').forEach(el=>cio.observe(el));

// drawer
const drawer = document.getElementById('drawer'), panel = document.getElementById('drawerPanel');
document.getElementById('burger').addEventListener('click', ()=>{
  drawer.classList.remove('hidden');
  requestAnimationFrame(()=>panel.classList.remove('translate-x-full'));
  document.body.style.overflow = 'hidden';
});
drawer.addEventListener('click', e=>{
  if(!e.target.closest('[data-close]')) return;
  panel.classList.add('translate-x-full');
  document.body.style.overflow = '';
  setTimeout(()=>drawer.classList.add('hidden'), 450);
});

